# ==========================================
# EcoVision AI – Environment Variables
# ==========================================
# Copy this file to .env and fill in values
# cp .env.example .env

# ----- Database -----
DATABASE_URL=postgresql+asyncpg://ecovision:ecovision123@localhost:5432/ecovision_db
POSTGRES_USER=ecovision
POSTGRES_PASSWORD=ecovision123
POSTGRES_DB=ecovision_db

# ----- Redis -----
REDIS_URL=redis://localhost:6379/0

# ----- JWT Auth -----
SECRET_KEY=your-super-secret-jwt-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- File Storage -----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ----- AI Models -----
AI_MODE=mock  # Options: mock | real
YOLO_WEIGHTS_PATH=./ai/yolo/weights/best.pt
SAM_WEIGHTS_PATH=./ai/segmentation/weights/sam2_hiera_large.pt
CLASSIFIER_WEIGHTS_PATH=./ai/classifier/weights/efficientnet_b4.pth
DEVICE=cpu  # Options: cpu | cuda | mps

# ----- LLM (Optional) -----
LLM_PROVIDER=template  # Options: template | openai | gemini
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
LLM_MODEL=gpt-4o-mini

# ----- Map -----
MAPBOX_ACCESS_TOKEN=your-mapbox-token-optional
NEXT_PUBLIC_API_URL=http://localhost:8000

# ----- Frontend URLs -----
LANDING_PAGE_URL=http://localhost:3000
CITIZEN_APP_URL=http://localhost:3001
MUNICIPAL_DASHBOARD_URL=http://localhost:3002

# ----- CORS -----
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002"]

# ----- Email (Notifications) -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@ecovision.ai
